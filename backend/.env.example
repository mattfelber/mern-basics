# Copy this file to .env and fill in your real MongoDB connection string.
# MongoDB Atlas (cloud) is free and recommended for beginners.
# Example Atlas URI format:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mern-basics?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/mern-basics
PORT=5000
